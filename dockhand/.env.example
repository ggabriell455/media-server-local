# Rode `id` no terminal e use o seu UID/GID
PUID=1000
PGID=1000

# GID do grupo "docker" no host. Descubra com: getent group docker | cut -d: -f3
DOCKER_GID=999

# Dados do Dockhand e pasta onde ficam os projetos compose (media/, immich/, dockhand/).
# Montados com o mesmo caminho dentro e fora do container (exigência do Dockhand)
DOCKHAND_DIR=/srv/config/dockhand
STACKS_DIR=/srv/stacks
