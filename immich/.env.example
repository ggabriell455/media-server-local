# Documentação das variáveis: https://docs.immich.app/install/environment-variables
#
# Copie este arquivo para .env (cp .env.example .env) e preencha DB_PASSWORD.

# Onde ficam fotos e vídeos (originais, miniaturas e cópias de segurança do banco)
UPLOAD_LOCATION=/srv/photos/immich

# Onde fica o banco de dados. Use disco local (de preferência SSD):
# compartilhamento de rede não é suportado
DB_DATA_LOCATION=/srv/config/immich-postgres

TZ=America/Sao_Paulo

# Versão do Immich. Fixada na v3 (como no .env oficial) para não pular
# sozinho para uma versão maior com mudanças incompatíveis
IMMICH_VERSION=v3

# Senha do Postgres (apenas A-Za-z0-9). OBRIGATÓRIO: vazia, o banco não sobe.
# Gere e preencha de uma vez, dentro da pasta immich/:
#   sed -i "s/^DB_PASSWORD=.*/DB_PASSWORD=$(openssl rand -hex 16)/" .env
# O Postgres só a aplica na primeira inicialização: trocar depois não altera
# a senha já gravada no banco
DB_PASSWORD=

# Os valores abaixo não precisam ser alterados
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
